{
  "functions": {
    "api/workspace.mjs": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/workspace?route=:path*"
    }
  ],
  "headers": [
    {
      "source": "/notion-workspace/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self' https://chaosconsole-tau.vercel.app; img-src 'self' data:; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    }
  ]
}
